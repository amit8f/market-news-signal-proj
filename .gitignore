.env
__pycache__/
*.pyc
data/raw/
data/interim/
data/processed/
data/live/
data/external/
models/

# research/ pipeline outputs (regenerable from research/*.py + data/external/) - same
# never-tracked convention as data/ above; write-ups belong in outputs/ instead, which stays tracked
research/*.csv
research/*.parquet
research/*.pkl
research/*.json
*.log
*.db
.venv/
venv/
.claude/
~/

# VM-pulled journal dumps - not source, may carry logged secrets (see
# FINNHUB_API_KEY leak in poll_failures.error / journal text, found in the
# 2026-09-03 pre-git audit); *.db above already covers the stray db pulls
/vm_pull_*.txt

# project bundles - redundant snapshots of this same source tree
*.tar.gz
*.tgz
