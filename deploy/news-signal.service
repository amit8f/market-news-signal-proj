[Unit]
Description=News-driven stock signal shadow loop (long-only, log-only)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/opt/news-signal
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/news-signal/.venv/bin/python -m news_signal.live.run_loop --loop
Restart=always
RestartSec=30

[Install]
WantedBy=multi-user.target
